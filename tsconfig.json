{
    "extends": "./tsconfig.base",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "checkJs": true,
        "lib": ["ES2020", "DOM"],
        "moduleDetection": "force",
        "allowImportingTsExtensions": true
    },
    "references": [
        { "path": "./tsconfig.node.json" },
        { "path": "./tsconfig.cloud.json" }
    ],
    "include": ["src/**/*"]
}
